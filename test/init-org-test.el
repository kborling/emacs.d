;;; -*- lexical-binding: t -*-
(require 'org)
(require 'ert)
(load (expand-file-name "lisp/init-org.el" user-emacs-directory) nil t)
(defun md (s) (with-temp-buffer (insert s) (kdb/markdown-to-org) (buffer-string)))
(ert-deftest md-to-org ()
  (should (equal (md "Open test_test.txt and my_file_name.txt") "Open test_test.txt and my_file_name.txt"))
  (should (equal (md "escaped test\\_test.txt and \\*star\\*") "escaped test_test.txt and *star*"))
  (should (equal (md "use `my_var_name` and `a*b*c`") "use =my_var_name= and =a*b*c="))
  (should (equal (md "_it_ and *it2* and **bold** and __b2__ and ~~del~~") "/it/ and /it2/ and *bold* and *b2* and +del+"))
  (should (equal (md "**bold with _it_ inside**") "*bold with /it/ inside*"))
  (should (equal (md "[a_b](https://x.com/a_b_/c) ![](img_1.png)") "[[https://x.com/a_b_/c][a_b]] [[img_1.png]]"))
  (should (equal (md "# Title\n## Sub ##\n* one\n  + two\n- three") "* Title\n** Sub\n- one\n  - two\n- three"))
  (should (equal (md "```bash\n# comment **x** my_var\n* not heading\n```\nafter") "#+begin_src bash\n# comment **x** my_var\n,* not heading\n#+end_src\nafter"))
  (should (equal (md "```\nplain\n```") "#+begin_src\nplain\n#+end_src"))
  (should (equal (md "| a | b |\n|:---|---:|\n| 1 | 2 |") "| a | b |\n|-\n| 1 | 2 |"))
  (should (equal (md "text\n\n---\n\nmore") "text\n\n-----\n\nmore"))
  (should (equal (md "__init__.py") "*init*.py")))
(ert-deftest org-html-filenames ()
  (let ((html (org-export-string-as (md "Open test_test.txt and test\\_x.txt") 'html t)))
    (should (string-match-p "test_test\\.txt and test_x\\.txt" html))
    (should-not (string-match-p "<sub>" html))))
(ert-deftest people-log ()
  (let* ((kdb/people-dir (make-temp-file "people" t))
         (file (kdb/ensure-people-file)))
    (with-current-buffer (find-file-noselect file)
      (kdb/ensure-person-section "Anna Smith")
      (kdb/ensure-person-section "Ann")
      (kdb/goto-person-subsection "Ann" "Wins")
      (insert "- first\n")
      (kdb/goto-person-subsection "Ann" "Wins")
      (insert "- second\n")
      (goto-char (point-max))
      (insert "* Bob")
      (kdb/goto-person-subsection "Bob" "Issues")
      (insert "- late\n")
      (should (string-suffix-p "* Anna Smith\n\n* Ann\n** Wins\n- second\n- first\n* Bob\n** Issues\n- late\n"
                               (buffer-string)))
      (set-buffer-modified-p nil)
      (kill-buffer))
    (delete-directory kdb/people-dir t)))
